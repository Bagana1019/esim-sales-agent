# Гаднаас хандах боломжтой URL (QPay callback, Telegram webhook-д ашиглана). Жишээ: ngrok URL
PUBLIC_BASE_URL=https://example.ngrok.app
DATABASE_URL=sqlite+aiosqlite:///./esim.db
CATALOG_PATH=data/catalog.yaml
SHOP_NAME=NomadData
# true бол QPay-ийн оронд хуурамч төлбөр (локал туршилт), туршилтын eSIM/лиценз санд автоматаар орно
FAKE_PAYMENTS=false

# И-мэйл (вэб захиалгын хүргэлт): Mailgun, үгүй бол SMTP. Аль нь ч хоосон бол илгээхгүй,
# out/emails хавтаст .eml болгон хадгална. Шалгах: uv run esim test-email таны@хаяг.mn
# Mailgun: API key (Mailgun → API Security), илгээх домэйн (жишээ нь mg.nomaddata.mn)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# us | eu — домэйноо аль бүсэд үүсгэснээс хамаарна
MAILGUN_REGION=us
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Илгээгч. Хоосон бол "SHOP_NAME <no-reply@MAILGUN_DOMAIN>"
MAIL_FROM=

# LLM — Groq (https://console.groq.com/keys). Хоосон бол зөвхөн товчлуурын урсгал ажиллана
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high — зөвхөн gpt-oss загваруудад. Өөр загвар сонговол хоосон үлдээнэ
GROQ_REASONING_EFFORT=low

# Telegram (@BotFather-аас авна)
TELEGRAM_BOT_TOKEN=
# Дурын урт санамсаргүй тэмдэгт мөр — webhook-ийн хүсэлтийг баталгаажуулна
TELEGRAM_WEBHOOK_SECRET=
# eSIM дууссан, алдаа гарсан үед мэдэгдэл авах админы chat id
ADMIN_CHAT_ID=

# QPay (доорх нь sandbox-ийн тестийн утгууд)
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn/v2
QPAY_CLIENT_ID=TEST_MERCHANT
QPAY_CLIENT_SECRET=123456
QPAY_INVOICE_CODE=TEST_INVOICE
# QPay callback URL-ийг гарын үсгээр хамгаалах нууц
CALLBACK_SECRET=change-me
