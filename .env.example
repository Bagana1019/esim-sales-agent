# Гаднаас хандах боломжтой URL (QPay callback, Telegram webhook-д ашиглана). Жишээ: ngrok URL
PUBLIC_BASE_URL=https://example.ngrok.app
DATABASE_URL=sqlite+aiosqlite:///./esim.db
CATALOG_PATH=data/catalog.yaml
SHOP_NAME=NomadData
# Үйлчилгээний нөхцөл, нууцлал, буцаалтын хуудас (/terms, /privacy, /refund) болон footer-т харагдана.
# Бөглөөгүй талбар тэр хуудсанд шараар тодорч харагдана
COMPANY_NAME=
COMPANY_REGISTER=
COMPANY_ADDRESS=
SUPPORT_EMAIL=
SUPPORT_PHONE=
# true бол QPay-ийн оронд хуурамч төлбөр (локал туршилт), туршилтын eSIM/лиценз санд автоматаар орно
FAKE_PAYMENTS=false
# Борлуулалтын дараа үлдэгдэл энэ тоо буюу түүнээс доош болвол админд Telegram-аар мэдэгдэнэ
LOW_STOCK_THRESHOLD=3

# Өгөгдлийн сангийн нөөц хуулбар. Жинхэнэ QPay-тэй ажиллахад сервер асахдаа, дараа нь
# BACKUP_INTERVAL_HOURS тутам өөрөө хийнэ (0 бол унтраана). Гараар: uv run esim backup
# Компьютер эвдэрвэл хамт алга болохгүйн тулд OneDrive/Google Drive хавтас руу заана, жишээ нь
# BACKUP_DIR=C:\Users\Lenovo\OneDrive\nomaddata-backups
BACKUP_DIR=backups
BACKUP_KEEP=30
BACKUP_INTERVAL_HOURS=24

# И-мэйл (вэб захиалгын хүргэлт): Mailgun, үгүй бол SMTP. Аль нь ч хоосон бол илгээхгүй,
# out/emails хавтаст .eml болгон хадгална. Шалгах: uv run esim test-email таны@хаяг.mn
# Mailgun: API key (Mailgun → API Security), илгээх домэйн (жишээ нь mg.nomaddata.mn)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# us | eu — домэйноо аль бүсэд үүсгэснээс хамаарна
MAILGUN_REGION=us
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Илгээгч. Хоосон бол "SHOP_NAME <no-reply@MAILGUN_DOMAIN>"
MAIL_FROM=

# LLM — Groq (https://console.groq.com/keys). Хоосон бол зөвхөн товчлуурын урсгал ажиллана
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high — зөвхөн gpt-oss загваруудад. Өөр загвар сонговол хоосон үлдээнэ
GROQ_REASONING_EFFORT=low

# Telegram (@BotFather-аас авна)
TELEGRAM_BOT_TOKEN=
# Дурын урт санамсаргүй тэмдэгт мөр — webhook-ийн хүсэлтийг баталгаажуулна
TELEGRAM_WEBHOOK_SECRET=
# eSIM дууссан, алдаа гарсан үед мэдэгдэл авах админы chat id
ADMIN_CHAT_ID=

# QPay. Доорх нь sandbox-ийн тестийн утгууд. Гэрээ хийсний дараа:
#   QPAY_BASE_URL=https://merchant.qpay.mn/v2, бусдад нь QPay-ээс авсан утгаа бичнэ.
#   Шалгах: uv run esim qpay-test (100₮-ийн жинхэнэ нэхэмжлэх үүсгэж, төлөгдөхийг хүлээнэ)
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn/v2
QPAY_CLIENT_ID=TEST_MERCHANT
QPAY_CLIENT_SECRET=123456
QPAY_INVOICE_CODE=TEST_INVOICE
# Захиалгын холбоос, QPay callback-ийг гарын үсгээр хамгаалах нууц. Жинхэнэ QPay-д 24+ тэмдэгт
# санамсаргүй утга заавал (үгүй бол сервер асахгүй). Үүсгэх:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Production-д асаасны дараа бүү солиорой — өмнөх захиалгын холбоосууд ажиллахаа болино.
CALLBACK_SECRET=change-me
